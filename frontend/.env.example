# Copy this file to `.env` and adjust as needed.
# Vite only exposes variables prefixed with `VITE_` to client code.

# When `true`, the SvelteKit dev server uses an in-browser mock of Reaper
# (songs/sets persisted in localStorage, tabs/transport simulated in memory).
# When `false` (default), the dev server proxies `/_/` to a real Reaper web
# instance — see VITE_REAPER_URL below.
VITE_USE_MOCK=false

# Used by the dev-server proxy (vite.config.ts). The Reaper web interface URL
# that `/_/...` requests are forwarded to. Adjust the port to match the value
# you configured in Reaper → Preferences → Control/OSC/Web.
#
# From a dev container on Linux you must also have host networking or a host
# gateway configured (the devcontainer.json sets up `host.docker.internal`).
VITE_REAPER_URL=http://host.docker.internal:8081
